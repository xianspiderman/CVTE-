# Copy to .env for manual setup, or let scripts/provision-local-db.py create it.
# Use a dedicated local MySQL account. Keep .env private (chmod 600).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scm_workbench
DB_USERNAME=scm_workbench
DB_PASSWORD=
MOCK_PORT=4010
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Optional: deterministic acceptance time. Leave empty for real local time.
SCM_FIXED_NOW=

# Optional AI: approved HTTPS Responses-compatible API base, e.g. https://models.example.com/v1.
# Model must support tool calling. Leave base URL and key empty for business-only mode.
SCM_AI_BASE_URL=
SCM_AI_MODEL=gpt-6.1-sol
SCM_AI_API_KEY=
