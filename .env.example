# Copy to .env; supply a dedicated local MySQL user. Never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=scm_workbench
DB_USERNAME=scm_workbench
DB_PASSWORD=replace-with-local-password
MOCK_PORT=4010
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Optional: deterministic acceptance time. Leave empty for real local time.
SCM_FIXED_NOW=

# Optional AI configuration. Leave credentials blank to run the business workbench alone.
SCM_AI_BASE_URL=
SCM_AI_MODEL=gpt-6.1-sol
SCM_AI_API_KEY=
